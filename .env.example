# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek V4 balanced defaults. Raise the effort only for exceptional
# deep-dive runs; disable thinking when latency matters more than reasoning.
TRADINGAGENTS_DEEPSEEK_QUICK_THINKING=disabled
TRADINGAGENTS_DEEPSEEK_QUICK_REASONING_EFFORT=low
TRADINGAGENTS_DEEPSEEK_DEEP_THINKING=enabled
TRADINGAGENTS_DEEPSEEK_DEEP_REASONING_EFFORT=medium
# Completion ceilings include visible text and provider reasoning tokens.
TRADINGAGENTS_QUICK_LLM_MAX_OUTPUT_TOKENS=8000
TRADINGAGENTS_DEEP_LLM_MAX_OUTPUT_TOKENS=16000
# Prompt budgets favor a concise, logic-led public memo while raw research
# remains available in saved context and internal audit artifacts.
PROMPT_CONTEXT_TOTAL_CHARS_ANALYST=28000
PROMPT_CONTEXT_TOTAL_CHARS_RESEARCH=32000
PROMPT_CONTEXT_TOTAL_CHARS_TRADER=16000
PROMPT_CONTEXT_TOTAL_CHARS_RISK=12000
PROMPT_CONTEXT_TOTAL_CHARS_PORTFOLIO=36000
STRUCTURED_RESEARCH_PROMPT_MAX_CHARS=36000
COMPANY_UNDERWRITING_PROMPT_MAX_CHARS=48000
STRUCTURED_RESEARCH_CACHE_ENABLED=true
STRUCTURED_RESEARCH_COMPONENT_CACHE_ENABLED=true
PM_EDITORIAL_REVIEW_MODE=on_issues
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=https://tt.dailyfetch.top/
TUSHARE_DISABLE_OFFICIAL_FALLBACK=true
